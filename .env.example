# Hans Oracle Environment Variables

# Convex Configuration
CONVEX_DEPLOY_KEY=your_convex_deploy_key_here
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# NFT/Blockchain API Keys
# OpenSea API v2 - Get from https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key_here

# Alchemy - Get from https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Moralis - Get from https://moralis.io/
MORALIS_API_KEY=your_moralis_api_key_here

# CoinGecko - Get from https://www.coingecko.com/en/api (optional, works without key)
COINGECKO_API_KEY=your_coingecko_api_key_here

# AI/LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CAESAR_API_KEY=your_caesar_api_key_here

# Authentication (Optional)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Optional Analytics
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# Production Settings
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://hans-oracle.vercel.app